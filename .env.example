# Copia este archivo como .env
# Desde el teléfono, 127.0.0.1 es el propio teléfono: usa la IP de tu computadora en la red Wi-Fi
# (en PowerShell: ipconfig → "Dirección IPv4" del adaptador Wi-Fi)
# El puerto es 34321 y no 54321 porque Windows suele reservar el rango 54xxx (ver supabase/config.toml)
EXPO_PUBLIC_SUPABASE_URL=http://<IP-de-tu-computadora>:34321
# La "Publishable key" que imprime `npm run db:start`
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
